# Local development. Copy to .env and adjust.

# SQLite file, relative to the prisma/ folder
DATABASE_URL=file:./dev.db

# "docker": each submission runs in a sandboxed container (needs Docker/Colima running).
# "local": runs code with your own gcc and NO sandbox, for when Docker is off.
JUDGE_ENGINE=docker

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Leave empty for open registration, or set a code students must type in
REGISTRATION_CODE=
